<?xml version="1.0" encoding="utf-8"?>
<!--
  しがのあさぼらけ — ストーリーエピローグ（エンディング）画面
  背景：夜明けの暗闇から黄金の朝焼けへ
  テキストが段階的にフェードインして感動的なクライマックスを演出
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/epilogueRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#100800"
    android:fitsSystemWindows="false">

    <!-- ===================================================================
         背景：夜明けグラデーション（基底レイヤー）
         =================================================================== -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/epilogue_bg_gradient" />

    <!-- ===================================================================
         朝焼けグロウ（中央から広がる金色の光）
         =================================================================== -->
    <View
        android:id="@+id/epilogueGlowOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/epilogue_glow_overlay"
        android:alpha="0" />

    <!-- ===================================================================
         コンテンツ（スクロール対応）
         =================================================================== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="72dp"
            android:paddingBottom="48dp"
            android:paddingHorizontal="20dp">

            <!-- ── タイトルエリア（朝焼けパネル） ───────────────── -->
            <LinearLayout
                android:id="@+id/epilogueTitlePanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#DD1A0800"
                android:paddingTop="24dp"
                android:paddingBottom="20dp"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="20dp"
                android:alpha="0">

                <!-- 🌅 朝焼け絵文字 -->
                <TextView
                    android:id="@+id/epilogueSunEmoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌅"
                    android:textSize="56sp"
                    android:layout_marginBottom="10dp" />

                <!-- メインタイトル -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="朝の光よ、滋賀に戻れ"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="#FFD700"
                    android:gravity="center"
                    android:letterSpacing="0.10"
                    android:layout_marginBottom="6dp"
                    android:shadowColor="#FFAA00"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="14" />

                <!-- 副タイトル -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="〜 伝説の開拓者、その旅の終わりに 〜"
                    android:textSize="12sp"
                    android:textColor="#DDFFC87C"
                    android:gravity="center"
                    android:letterSpacing="0.05" />

            </LinearLayout>

            <!-- ── 上部区切り線 ──────────────────────────────────────── -->
            <View
                android:id="@+id/epilogueDividerTop"
                android:layout_width="160dp"
                android:layout_height="1dp"
                android:background="#66FFD700"
                android:layout_marginBottom="18dp"
                android:alpha="0" />

            <!-- ── テキスト① ──────────────────────────────────────── -->
            <TextView
                android:id="@+id/epilogueText1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="19の市町を巡り、\nあなたは長い旅を終えた。"
                android:textSize="16sp"
                android:textColor="#FFFFFFFF"
                android:gravity="center"
                android:lineSpacingMultiplier="1.8"
                android:background="#CC1A0800"
                android:padding="18dp"
                android:layout_marginBottom="12dp"
                android:alpha="0" />

            <!-- ── テキスト② ──────────────────────────────────────── -->
            <TextView
                android:id="@+id/epilogueText2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="神さまたちは眠い目をこすり、\nようやくお布団から出てきた。\n\n「おはよう……そうか、もう朝か」\n\n琵琶湖の水面に、\n金色の朝日が差し込む。"
                android:textSize="15sp"
                android:textColor="#FFFFFFFF"
                android:gravity="center"
                android:lineSpacingMultiplier="1.8"
                android:background="#CC1A0800"
                android:padding="18dp"
                android:layout_marginBottom="12dp"
                android:alpha="0" />

            <!-- ── テキスト③ ──────────────────────────────────────── -->
            <TextView
                android:id="@+id/epilogueText3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="紫の夜霧は晴れ、\n滋賀の大地に\nみずみずしい緑が輝いた。"
                android:textSize="15sp"
                android:textColor="#FFFFFFFF"
                android:gravity="center"
                android:lineSpacingMultiplier="1.8"
                android:background="#CC1A0800"
                android:padding="18dp"
                android:layout_marginBottom="20dp"
                android:alpha="0" />

            <!-- ── 朝の絵文字 ────────────────────────────────────────── -->
            <TextView
                android:id="@+id/epilogueMorningEmoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌄 🌿 🌊"
                android:textSize="36sp"
                android:layout_marginBottom="20dp"
                android:alpha="0" />

            <!-- ── 区切り線 ──────────────────────────────────────────── -->
            <View
                android:id="@+id/epilogueDivider"
                android:layout_width="200dp"
                android:layout_height="1dp"
                android:background="#66FFD700"
                android:layout_marginBottom="20dp"
                android:alpha="0" />

            <!-- ── 称号カード ──────────────────────────────────────── -->
            <LinearLayout
                android:id="@+id/layoutEpilogueTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/epilogue_title_card_bg"
                android:padding="24dp"
                android:layout_marginBottom="20dp"
                android:gravity="center"
                android:alpha="0">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏆  称号獲得  🏆"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FFD700"
                    android:layout_marginBottom="14dp"
                    android:shadowColor="#FFAA00"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="8" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="★  滋賀を救った英雄  ★\n伝説の開拓者"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFFFF"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.6"
                    android:layout_marginBottom="16dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#4DFFD700"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="全19市町を制覇！\n滋賀県の朝を取り戻した。"
                    android:textSize="14sp"
                    android:textColor="#DDFFC87C"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.6" />

            </LinearLayout>

            <!-- ── テキスト④（締め） ─────────────────────────────── -->
            <TextView
                android:id="@+id/epilogueText4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="「また、いつでも会いに来てね」\n\n神さまたちは、満面の笑みで手を振った。"
                android:textSize="15sp"
                android:textColor="#FFFFFFFF"
                android:gravity="center"
                android:lineSpacingMultiplier="1.8"
                android:background="#CC1A0800"
                android:padding="18dp"
                android:layout_marginBottom="36dp"
                android:alpha="0" />

            <!-- ── 「冒険を続ける」ボタン ──────────────────────────────── -->
            <Button
                android:id="@+id/btnContinueAdventure"
                android:layout_width="260dp"
                android:layout_height="60dp"
                android:text="🌅  冒険を続ける"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1A0800"
                android:backgroundTint="#FFD700"
                android:layout_marginBottom="16dp"
                android:elevation="10dp"
                android:visibility="invisible"
                style="@style/Widget.AppCompat.Button" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>
