<?xml version="1.0" encoding="utf-8"?>
<!-- ミッションカード背景：緑の発光枠 + 半透明ダーク背景 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 外枠（緑の発光） -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#3350C864" />
            <stroke android:width="1.5dp" android:color="#6650C864" />
        </shape>
    </item>
    <!-- 内側（少し内側でダーク） -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="15dp" />
            <solid android:color="#22001A00" />
        </shape>
    </item>
</layer-list>
